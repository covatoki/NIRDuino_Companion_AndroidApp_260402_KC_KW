<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- ── Device and Layout Stacked Group ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/group_device_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_connect"
        android:layout_marginEnd="8dp">

        <!-- Device Row -->
        <TextView
            android:id="@+id/label_select_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select device:"
            android:textSize="@dimen/font_size_header2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/spinner_aliases"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/spinner_aliases"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            app:layout_constraintStart_toEndOf="@id/label_select_device"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/label_select_device"
            android:layout_marginEnd="8dp"/>

        <!-- Layout Row -->
        <TextView
            android:id="@+id/label_select_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select layout:"
            android:textSize="@dimen/font_size_header2"
            app:layout_constraintTop_toBottomOf="@id/spinner_aliases"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/spinner_layouts"
            android:layout_marginTop="@dimen/font_size_header2"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/spinner_layouts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            app:layout_constraintTop_toBottomOf="@id/spinner_aliases"
            app:layout_constraintStart_toEndOf="@id/label_select_layout"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/font_size_header2"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Connect Button aligned to height of both rows -->
    <Button
        android:id="@+id/btn_connect"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="Connect"
        app:layout_constraintTop_toTopOf="@id/group_device_layout"
        app:layout_constraintBottom_toBottomOf="@id/group_device_layout"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status Text -->
    <TextView
        android:id="@+id/text_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select a device to connect"
        android:textSize="@dimen/font_size_header3"
        android:layout_marginTop="@dimen/font_size_header2"
        app:layout_constraintTop_toBottomOf="@id/group_device_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/timerBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/text_status"
        app:layout_constraintBottom_toTopOf="@id/btn_stream_toggle"
        android:layout_margin="@dimen/font_size_footnote"
        android:weightSum="3">

        <!-- Status Text -->
        <ImageView
            android:id="@+id/image_signal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/signal_level2"
            android:layout_weight="1"
            app:tint="@color/white" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/text_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            app:layout_constraintTop_toBottomOf="@id/group_device_layout"
            android:textSize="@dimen/font_size_header2"
            android:textStyle="italic|bold"
            android:textAlignment="center"
            android:layout_weight="1"/>

        <ImageView
            android:id="@+id/image_battery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/battery_level5"
            android:layout_weight="1"
            app:tint="@color/white" />

    </LinearLayout>

    <Button
        android:id="@+id/btn_stream_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Streaming"
        app:layout_constraintTop_toBottomOf="@id/timerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.nirduino_android_app_v2.device_communication.SignalQualityOverlay
        android:id="@+id/sqi_overlay"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:background="#220000FF"
        app:layout_constraintTop_toBottomOf="@id/btn_stream_toggle"
 />

    <!-- Spinner row with label -->
    <LinearLayout
        android:id="@+id/channel_spinner_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/sqi_overlay">

        <TextView
            android:id="@+id/label_select_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Channel:"
            android:textSize="@dimen/font_size_header2"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spinner_channels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:spinnerMode="dropdown" />

    </LinearLayout>

    <!-- Placeholder for real-time plot -->
    <com.example.nirduino_android_app_v2.device_communication.ChannelPlotView
        android:id="@+id/channel_plot_view"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/channel_spinner_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stimulus library and notes:"
        app:layout_constraintBottom_toTopOf="@id/stimulus_bar"
        android:textSize="@dimen/font_size_header2"/>

    <LinearLayout
        android:id="@+id/stimulus_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/white"
        android:baselineAligned="false"
        android:scrollbars="horizontal">

        <!-- Dynamic buttons will be added here in code -->

        <Button
            android:id="@+id/btn_add_stimulus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add stimulus"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text= "Notes:"
                android:textSize="@dimen/font_size_header3"/>

            <EditText
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Enter any notes in this text box..."
                android:textSize="@dimen/font_size_paragraph"
                />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
