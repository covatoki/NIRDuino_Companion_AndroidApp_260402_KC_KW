<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".participant_manager.ParticipantForm">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Note -->
            <TextView
                android:id="@+id/mandatory_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="* indicates required field"
                android:textSize="@dimen/font_size_header3"
                android:textColor="@android:color/darker_gray"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Helper function to make field blocks -->
            <!-- Label + EditText blocks for all fields -->

            <!-- Subject ID* -->
            <TextView
                android:id="@+id/label_subject_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Subject ID *"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/mandatory_note"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_subject_id"
                app:layout_constraintBaseline_toBaselineOf="@id/input_subject_id" />

            <EditText
                android:id="@+id/input_subject_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="e.g., subj_001"
                android:textSize="@dimen/font_size_header3"
                android:inputType="text"
                app:layout_constraintTop_toBottomOf="@id/mandatory_note"
                app:layout_constraintStart_toEndOf="@id/label_subject_id"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- age -->
            <TextView
                android:id="@+id/label_age"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Age"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/input_subject_id"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_age"
                app:layout_constraintBaseline_toBaselineOf="@id/input_age" />

            <EditText
                android:id="@+id/input_age"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="e.g., 28"
                android:inputType="number"
                android:textSize="@dimen/font_size_header3"
                app:layout_constraintTop_toBottomOf="@id/input_subject_id"
                app:layout_constraintStart_toEndOf="@id/label_age"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- sex -->
            <TextView
                android:id="@+id/label_sex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Sex"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/input_age"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_sex"
                app:layout_constraintBaseline_toBaselineOf="@id/input_sex" />

            <EditText
                android:id="@+id/input_sex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="M / F / Other"
                android:textSize="@dimen/font_size_header3"
                app:layout_constraintTop_toBottomOf="@id/input_age"
                app:layout_constraintStart_toEndOf="@id/label_sex"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- handedness -->
            <TextView
                android:id="@+id/label_handedness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Handedness"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/input_sex"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_handedness"
                app:layout_constraintBaseline_toBaselineOf="@id/input_handedness" />

            <EditText
                android:id="@+id/input_handedness"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="Right / Left / Ambidextrous"
                android:textSize="@dimen/font_size_header3"
                app:layout_constraintTop_toBottomOf="@id/input_sex"
                app:layout_constraintStart_toEndOf="@id/label_handedness"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- weight -->
            <TextView
                android:id="@+id/label_weight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Weight (kg)"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/input_handedness"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_weight"
                app:layout_constraintBaseline_toBaselineOf="@id/input_weight" />

            <EditText
                android:id="@+id/input_weight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="e.g., 70"
                android:inputType="numberDecimal"
                android:textSize="@dimen/font_size_header3"
                app:layout_constraintTop_toBottomOf="@id/input_handedness"
                app:layout_constraintStart_toEndOf="@id/label_weight"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- height -->
            <TextView
                android:id="@+id/label_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Height (cm)"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/input_weight"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_height"
                app:layout_constraintBaseline_toBaselineOf="@id/input_height" />

            <EditText
                android:id="@+id/input_height"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="e.g., 170"
                android:inputType="numberDecimal"
                android:textSize="@dimen/font_size_header3"
                app:layout_constraintTop_toBottomOf="@id/input_weight"
                app:layout_constraintStart_toEndOf="@id/label_height"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ethnicity -->
            <TextView
                android:id="@+id/label_ethnicity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ethnicity"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/input_height"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_ethnicity"
                app:layout_constraintBaseline_toBaselineOf="@id/input_ethnicity" />

            <EditText
                android:id="@+id/input_ethnicity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="e.g., Asian"
                android:textSize="@dimen/font_size_header3"
                app:layout_constraintTop_toBottomOf="@id/input_height"
                app:layout_constraintStart_toEndOf="@id/label_ethnicity"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- comments -->
            <TextView
                android:id="@+id/label_comments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Comments"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/input_ethnicity"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/input_comments"
                app:layout_constraintBaseline_toBaselineOf="@id/input_comments" />

            <EditText
                android:id="@+id/input_comments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="e.g., Notes here"
                android:inputType="textMultiLine"
                android:textSize="@dimen/font_size_header3"
                app:layout_constraintTop_toBottomOf="@id/input_ethnicity"
                app:layout_constraintStart_toEndOf="@id/label_comments"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Save Button -->
            <Button
                android:id="@+id/button_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textSize="@dimen/font_size_header3"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                app:layout_constraintTop_toBottomOf="@id/input_comments"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- Data-security notice -->
    <TextView
        android:id="@+id/text_security_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 Records are stored locally with AES-256 encryption, meeting HIPAA / GDPR encryption-at-rest standards."
        android:textSize="@dimen/font_size_header3"
        android:textColor="@android:color/darker_gray"
        android:textAlignment="center"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>