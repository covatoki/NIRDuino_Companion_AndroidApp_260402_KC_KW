<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- ───── Title ───── -->
    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SNIRF Converter"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ───── Row: Participant label + spinner ───── -->
    <TextView
        android:id="@+id/label_participant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select the participant ID:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_title"
        android:layout_marginTop="12dp"
        android:textSize="@dimen/font_size_header2" />

    <Spinner
        android:id="@+id/spinner_participant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/label_participant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/label_participant"
        android:textSize="@dimen/font_size_header2"/>

    <!-- ───── Choose CSV button + file name ───── -->
    <Button
        android:id="@+id/button_pick_json"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose the data file"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_participant"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/text_json_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="No file selected"
        android:textSize="@dimen/font_size_header2"
        app:layout_constraintTop_toBottomOf="@id/button_pick_json"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="30dp"
        tools:layout_editor_absoluteX="16dp" />

    <TextView
        android:id="@+id/fileQaTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:ellipsize="none"
        android:singleLine="false"
        android:maxLines="10"
        android:scrollHorizontally="false"
        android:textSize="@dimen/font_size_header3"
        app:layout_constraintTop_toBottomOf="@id/text_json_name"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- ───── Generate button ───── -->

    <Button
        android:id="@+id/button_generate_snirf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate SNIRF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/outputTextView"
        android:layout_marginBottom="40dp" />

    <TextView
        android:id="@+id/outputTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/button_generate_snirf"
        app:layout_constraintBottom_toBottomOf="parent"
        android:text="No output file generated"
        android:textSize="@dimen/font_size_header2"
        android:layout_marginBottom="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
