<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- ───── Title ───── -->
    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SNIRF Converter"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ───── Row: Layout label + spinner ───── -->
    <TextView
        android:id="@+id/label_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select the source-detector layout used:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_title"
        android:layout_marginTop="16dp"
        android:textSize="@dimen/font_size_header3"/>

    <Spinner
        android:id="@+id/spinner_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/label_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/label_layout"
        android:textSize="@dimen/font_size_header3" />

    <!-- ───── Row: Participant label + spinner ───── -->
    <TextView
        android:id="@+id/label_participant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select the participant ID:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_layout"
        android:layout_marginTop="12dp"
        android:textSize="@dimen/font_size_header3" />

    <Spinner
        android:id="@+id/spinner_participant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/label_participant"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/label_participant"
        android:textSize="@dimen/font_size_header3" />

    <!-- ───── Choose CSV button + file name ───── -->
    <Button
        android:id="@+id/button_pick_csv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose the data file"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/label_participant"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/text_csv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="No file selected"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/button_pick_csv"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/button_pick_csv"
        android:layout_marginStart="8dp" />

    <!-- ───── Stimulus label ───── -->
    <EditText
        android:id="@+id/edit_stimulus_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Stimulus type (e.g., Math)"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_pick_csv"
        android:layout_marginTop="16dp" />

    <!-- ───── Notes field ───── -->
    <EditText
        android:id="@+id/edit_notes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:hint="Optional notes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_stimulus_label"
        android:layout_marginTop="12dp" />

    <!-- ───── Generate button ───── -->
    <Button
        android:id="@+id/button_generate_snirf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Generate SNIRF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edit_notes"
        android:layout_marginTop="20dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
