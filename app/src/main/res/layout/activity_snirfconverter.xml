<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/text_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SNIRF Generator Tool"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/font_size_header1"
        android:layout_marginTop="4dp"/>

    <!-- Row: Label + Configuration Spinner -->
    <LinearLayout
        android:id="@+id/layout_configuration_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/text_title"
        android:layout_marginTop="@dimen/font_size_header3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/text_configuration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select experimental configuration:"
            android:textSize="@dimen/font_size_header3"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/spinner_configuration"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:textSize="@dimen/font_size_header3"/>
    </LinearLayout>

    <!-- Participants List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_participants"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layout_configuration_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="@dimen/font_size_header3" />

    <!-- Row: File Picker Button + Summary Text -->
    <LinearLayout
        android:id="@+id/layout_file_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/recycler_participants"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- File Picker Button -->
        <Button
            android:id="@+id/button_pick_directory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Data Folder"
            android:textSize="@dimen/font_size_header3" />

        <!-- File Summary Text -->
        <TextView
            android:id="@+id/text_file_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="No folder selected"
            android:textSize="@dimen/font_size_header3"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- File Summary Text -->
    <TextView
        android:id="@+id/text_folder_contents"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:text="No folder selected"
        android:textSize="@dimen/font_size_header3"
        android:layout_marginStart="12dp"
        android:layout_gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_weight="1"
        app:layout_constraintTop_toBottomOf="@id/layout_file_row"/>

    <!-- Submit Button -->
    <Button
        android:id="@+id/button_generate_snirf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Generate SNIRF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_folder_contents" />

</androidx.constraintlayout.widget.ConstraintLayout>
